---
import "../styles/global.css"

const year = new Date().getFullYear()

const SOCIAL = [
  { label: 'Discord', href: 'https://discord.gg/xHJrCNA8y5' },
  { label: 'GitHub', href: 'https://github.com/Devollox/void-webhooks' },
]

const PRODUCT = [
  { label: 'Download client', href: 'https://voidpresence.com/download' },
  { label: 'Profiles and cycles', href: 'https://voidpresence.com/configs' },
]

const RESOURCES = [
  { label: 'Docs', href: 'https://voidpresence.com/docs' },
  { label: 'Status', href: 'https://voidpresence.com/status' },
  { label: 'API', href: 'https://voidpresence.com/api' },
  { label: 'Webhooks', href: 'https://webhooks.voidpresence.com' },
]

const META = [
  { label: 'Changelog', href: 'https://github.com/Devollox/void-presence/releases' },
  { label: 'Repository', href: 'https://github.com/Devollox/void-webhooks' },
]
---

<footer class="relative overflow-hidden border-t border-[#222] bg-black py-8 pb-6">
  <div class="relative z-10 mx-auto max-w-[1200px] px-4">
    <div class="mb-5 grid gap-5 md:grid-cols-[minmax(0,2fr)_minmax(0,3fr)] lg:grid-cols-[minmax(0,2.2fr)_minmax(0,3fr)]">
      <div class="flex flex-col gap-3.5">
        <div class="flex items-center gap-3">
          <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-[14px] border border-white/[0.12] bg-[#0a0a0a]/[0.85] text-[13px] tracking-[0.16em] text-[#f9fafb]">
            vP
          </div>
          <div>
            <h3 class="mb-0.5 text-xl font-semibold text-gray-200">Void Presence</h3>
            <p class="m-0 max-w-[320px] text-[13px] text-gray-400">
              Advanced Discord Rich Presence manager with profiles, cycles, buttons and images.
            </p>
          </div>
        </div>

        <div class="flex flex-wrap gap-2">
          {SOCIAL.map((link) => (
            <a
              href={link.href}
              target="_blank"
              rel="noreferrer"
              class="inline-flex items-center justify-center rounded-full border border-white/[0.12] bg-[#0a0a0a]/[0.85] px-3 py-1.5 transition-all duration-150 hover:border-white/[0.06] hover:bg-[#1a1a1a]/[0.55]"
            >
              <span class="text-xs tracking-[0.02em] text-gray-200">{link.label}</span>
            </a>
          ))}
        </div>

        <div class="flex items-center gap-1.5 text-xs text-gray-500">
          <span>Built with focus by</span>
          <span class="text-[10px] text-red-500">●</span>
          <span>devollox</span>
        </div>
      </div>

      <div class="grid gap-4 sm:flex sm:justify-around">
        <div class="flex flex-col gap-2">
          <h4 class="mb-1 text-[11px] uppercase tracking-[0.16em] text-gray-200">Product</h4>
          <ul class="m-0 flex list-none flex-col gap-1 p-0">
            {PRODUCT.map((link) => (
              <li>
                <a href={link.href} class="inline-block py-0.5 text-[13px] text-gray-400 transition-colors duration-150 hover:text-gray-200">
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>

        <div class="flex flex-col gap-2">
          <h4 class="mb-1 text-[11px] uppercase tracking-[0.16em] text-gray-200">Resources</h4>
          <ul class="m-0 flex list-none flex-col gap-1 p-0">
            {RESOURCES.map((link) => (
              <li>
                <a href={link.href} class="inline-block py-0.5 text-[13px] text-gray-400 transition-colors duration-150 hover:text-gray-200">
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>

        <div class="flex flex-col gap-2">
          <h4 class="mb-1 text-[11px] uppercase tracking-[0.16em] text-gray-200">Meta</h4>
          <ul class="m-0 flex list-none flex-col gap-1 p-0">
            {META.map((link) => (
              <li>
                <a href={link.href} target="_blank" rel="noreferrer" class="inline-block py-0.5 text-[13px] text-gray-400 transition-colors duration-150 hover:text-gray-200">
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>

    <div class="flex flex-col gap-2 border-t border-white/[0.12] pt-3 md:flex-row md:items-center md:justify-between">
      <div class="text-xs text-gray-500">
        <div>© {year} Void Presence. All rights reserved.</div>
        <div class="mt-0.5 text-[11px] text-gray-600">
          GitHub to Discord notification service — subscriptions, signatures and async delivery.
        </div>
      </div>
      <div class="flex flex-wrap gap-0">
        <span class="ml-2.5 rounded-full border border-white/[0.12] bg-[#0a0a0a]/[0.85] px-2.5 py-1 text-[11px] text-gray-400">
          NestJS · Fastify
        </span>
        <span class="ml-2.5 rounded-full border border-white/[0.12] bg-[#0a0a0a]/[0.85] px-2.5 py-1 text-[11px] text-gray-400">
          GitHub Webhooks
        </span>
      </div>
    </div>
  </div>
</footer>
