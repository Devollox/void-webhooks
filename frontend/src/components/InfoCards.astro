---
const cards = [
  {
    title: 'Overview',
    lines: [
      'This service exposes a single',
      'endpoint that accepts incoming events from any external service.',
      'Each request is validated, persisted to PostgreSQL, and queued for async processing.',
    ],
    code: 'POST /webhooks/github',
  },
  {
    title: 'How it works',
    lines: [
      'Incoming events are queued via Bull and handled by a background worker independently of the HTTP response.',
      'The API responds immediately with a success so the sender is never blocked waiting for processing to finish.',
    ],
  },
  {
    title: 'Setup',
    lines: [
      'Configure your GitHub repository to send webhook events to',
      'Set a secret and subscribe to the events you care about.',
    ],
    code: '/webhooks/github',
    link: { href: 'https://github.com/Devollox/void-webhook', label: 'View source on GitHub' },
  },
  {
    title: 'Usage notes',
    lines: [
      'Redis is used for deduplication and job queueing — avoid flooding the endpoint with high-frequency requests.',
      'For heavy integrations, pre-process and batch events on your side before forwarding them here.',
    ],
  },
]
---

<section class="pt-8 max-md:px-[var(--section-padding-mobile)] max-md:pt-5">
  <div class="max-w-[1400px] mx-auto">
    <div class="grid gap-5 mb-5" style="grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));">
      {cards.map((card) => (
        <div class="w-full box-border flex flex-col bg-[rgba(23,23,23,0.9)] border border-[rgba(255,255,255,0.04)] rounded-2xl p-[14px_16px] h-[188px]">
          <h4 class="text-[#f1f1f1] m-0 mb-1 text-[13px] font-semibold">{card.title}</h4>
          {card.lines.map((line, i) => (
            <p class="text-[#a1a1aa] m-0 text-[13px] leading-tight">
              {i === 0 && card.code ? (
                <>
                  {line}{' '}
                  <code class="text-[#e4e4e7] bg-[rgba(255,255,255,0.06)] px-1 py-px rounded text-[12px]">
                    {card.code}
                  </code>
                </>
              ) : (
                line
              )}
            </p>
          ))}
          {card.link && (
            <a
              href={card.link.href}
              target="_blank"
              rel="noreferrer"
              class="mt-auto w-full text-white text-center bg-[#272727] border border-[rgba(255,255,255,0.1)] rounded-xl px-4 py-[10px] text-[13px] font-medium no-underline transition-all duration-200 block hover:bg-[rgba(255,255,255,0.15)] hover:border-[rgba(255,255,255,0.2)] hover:-translate-y-px hover:shadow-[0_4px_12px_rgba(0,0,0,0.3)] mt-4"
            >
              {card.link.label}
            </a>
          )}
        </div>
      ))}
    </div>
  </div>
</section>
